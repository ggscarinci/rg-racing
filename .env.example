# Crie .env somente no servidor, com permissão 600.
ADMIN_USERNAME=operador
# Obrigatória na primeira execução. Use uma senha própria, com 12 ou mais caracteres.
ADMIN_PASSWORD=
SECURE_COOKIES=1
TRUST_PROXY=0
RG_RACING_VERSION=local
RG_RACING_PORT=3007
# Somente ao usar deploy/compose.proxy.yml: rede Docker compartilhada com o Caddy.
PROXY_NETWORK=
